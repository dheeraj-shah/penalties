{
  "name": "penalties-game",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "build": { "command": "npm run build" },
  "vars": { "AI_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "penalties-demo-budget", "database_id": "YOUR_DATABASE_ID" }],
  "routes": [
    { "pattern": "YOUR_DOMAIN/penalties", "zone_name": "YOUR_DOMAIN" },
    { "pattern": "YOUR_DOMAIN/penalties/*", "zone_name": "YOUR_DOMAIN" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
